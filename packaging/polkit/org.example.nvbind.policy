<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <action id="org.example.nvbind.manage">
    <description>Manage NVIDIA GPU driver binding</description>
    <message>Authentication is required to manage NVIDIA GPU binding</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
